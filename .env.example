# Mobile app API URL.
# For web on the same computer:
EXPO_PUBLIC_API_URL=http://localhost:8080/api
# For iPhone/Android on the same Wi-Fi, replace localhost with laptop IP:
# EXPO_PUBLIC_API_URL=http://10.85.33.89:8080/api

# Docker ports.
API_PORT=8080
POSTGRES_PORT=5432

# Postgres inside Docker.
POSTGRES_DB=rent_astana
POSTGRES_USER=rent
POSTGRES_PASSWORD=rent

# Backend security. Replace on server with a long random value.
JWT_SECRET=local-dev-secret-change-on-server

# Public base URL used for generated media links.
PUBLIC_BASE_URL=http://localhost:8080

# Full path to local file storage on host machine.
# Windows example:
FILE_STORAGE_PATH=C:/Users/zhanat/Desktop/bazarent
# Linux server example:
# FILE_STORAGE_PATH=/data/bazarent
